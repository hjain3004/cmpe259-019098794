# Copy to code/.env (never committed) and fill in.
ANTHROPIC_API_KEY=
# Model for extraction and answering (default claude-haiku-5-5)
# LLM_MODEL=claude-haiku-5-5
# Gemini instead: run with --llm gemini and set
# GEMINI_API_KEY=
# Optional: minimum seconds between calls, for free-tier rate limits
# LLM_MIN_INTERVAL=4
