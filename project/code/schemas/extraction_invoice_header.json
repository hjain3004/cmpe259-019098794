{
  "$defs": {
    "Extracted": {
      "additionalProperties": false,
      "description": "One extracted value and the verbatim text it was read from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value as printed, or null if absent.",
          "title": "Value"
        },
        "source_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact text copied from the document that contains the value.",
          "title": "Source Quote"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page of source_quote.",
          "title": "Page"
        }
      },
      "title": "Extracted",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Call 1 per invoice: a shallow header (14 fields, no nesting beyond Extracted).",
  "properties": {
